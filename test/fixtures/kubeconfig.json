{
  "clusters": [
    {
      "name": "arn:aws:eks:eu-west-1:111111111111:cluster/demo-dev-main",
      "cluster": {
        "server": "https://127.0.0.1:18042",
        "tls-server-name": "AAAA1111.gr7.eu-west-1.eks.amazonaws.com"
      }
    },
    {
      "name": "arn:aws:eks:us-east-1:222222222222:cluster/demo-prod-main",
      "cluster": {
        "server": "https://BBBB2222.gr7.us-east-1.eks.amazonaws.com:8000"
      }
    },
    {
      "name": "arn:aws:eks:eu-west-1:333333333333:cluster/demo-stage-main",
      "cluster": {
        "server": "https://127.0.0.1:18077"
      }
    },
    {
      "name": "docker-desktop",
      "cluster": {
        "server": "https://127.0.0.1:6443"
      }
    }
  ],
  "contexts": [
    {
      "name": "demo-dev-main",
      "context": {
        "cluster": "arn:aws:eks:eu-west-1:111111111111:cluster/demo-dev-main",
        "user": "u-dev"
      }
    },
    {
      "name": "demo-prod-main",
      "context": {
        "cluster": "arn:aws:eks:us-east-1:222222222222:cluster/demo-prod-main",
        "user": "u-prod"
      }
    },
    {
      "name": "demo-stage-main",
      "context": {
        "cluster": "arn:aws:eks:eu-west-1:333333333333:cluster/demo-stage-main",
        "user": "u-stage"
      }
    },
    {
      "name": "docker-desktop",
      "context": {
        "cluster": "docker-desktop",
        "user": "docker-desktop"
      }
    }
  ],
  "users": [
    {
      "name": "u-dev",
      "user": {
        "exec": {
          "env": [
            {"name": "AWS_PROFILE", "value": "demo-dev"}
          ]
        }
      }
    },
    {
      "name": "u-prod",
      "user": {
        "exec": {
          "env": null
        }
      }
    },
    {
      "name": "u-stage",
      "user": {
        "exec": {
          "env": [
            {"name": "AWS_PROFILE", "value": "demo-stage"}
          ]
        }
      }
    },
    {
      "name": "docker-desktop",
      "user": {}
    }
  ]
}
